#!/bin/bash
# ============================================================
# PBS Job: CTC Head Training — RESUME from epoch 17
# ============================================================
# Submit: qsub hpc/run_ctc_resume.pbs
# Monitor: qstat -u 2025rcs1026
# Live logs: tail -f ~/Indain_children_spech/hpc/ctc_resume.log
# ============================================================

#PBS -N ctc_resume
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=12:00:00
#PBS -j oe

# Move to project directory
cd /iitjfs/home/2025rcs1026/Indain_children_spech

# Load conda
module load codes/anaconda3-2023.09
source activate children_asr

# GPU nodes have no internet — use cached models only
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1

# Force Python to flush output immediately
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/ctc_resume.log"

echo "============================================================" | tee $LOGFILE
echo "  CTC HEAD TRAINING — RESUME from epoch 17" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u scripts/semantic/ctc_training.py \
    --epochs 30 \
    --lr 1e-3 \
    --patience 5 \
    --warmup_steps 500 \
    --resume checkpoints/semantic/ctc_epoch_17.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
