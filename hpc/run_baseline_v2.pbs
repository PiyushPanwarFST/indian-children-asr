#!/bin/bash
# ============================================================
# PBS Job: Baseline V2 — Whisper Small Fine-tuning (Fair, Regularized)
# ============================================================
# Standard fine-tuning with proper regularization:
#   - SpecAugment (2 freq + 2 time masks)
#   - Dropout 0.1
#   - Label smoothing 0.1
#   - Gradient accumulation 16 (effective batch size 16)
#   - Encoder frozen (standard for small datasets)
# Submit: qsub hpc/run_baseline_v2.pbs
# ============================================================

#PBS -N baseline_v2
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=24:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/baseline_v2.log"

echo "============================================================" > $LOGFILE
echo "  BASELINE V2: Whisper Small Fine-tuning (Regularized)" >> $LOGFILE
echo "  SpecAugment: ON | Dropout: 0.1 | Label Smoothing: 0.1" >> $LOGFILE
echo "  Grad Accum: 16 | Encoder: FROZEN" >> $LOGFILE
echo "  Node: $(hostname)" >> $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'NO GPU')" >> $LOGFILE
echo "  CUDA available: $(python -c 'import torch; print(torch.cuda.is_available())' 2>&1)" >> $LOGFILE
echo "  Started: $(date)" >> $LOGFILE
echo "============================================================" >> $LOGFILE

python -u experiments/baselines/baseline_finetune.py \
    --model whisper-small \
    --epochs 15 \
    --patience 5 \
    --lr 1e-5 \
    --warmup_steps 200 \
    --dropout 0.1 \
    --label_smoothing 0.1 \
    --grad_accum 16 \
    --freeze_encoder \
    --specaugment \
    --grad_checkpoint \
    >> $LOGFILE 2>&1

EXIT_CODE=$?
echo "" >> $LOGFILE
echo "  EXIT CODE: $EXIT_CODE" >> $LOGFILE
echo "  DONE: $(date)" >> $LOGFILE
