#!/bin/bash
# ============================================================
# PBS Job: Baseline V2 — Whisper Small Fine-tuning with Regularization
# ============================================================
# Tighter training: higher dropout, label smoothing, lower patience
# Submit: qsub hpc/run_baseline_v2.pbs
# ============================================================

#PBS -N baseline_v2
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=24:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/baseline_v2.log"

echo "============================================================" | tee $LOGFILE
echo "  BASELINE V2: Whisper Small Fine-tuning (Regularized)" | tee -a $LOGFILE
echo "  Dropout: 0.15, Label Smoothing: 0.1" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u experiments/baselines/baseline_finetune.py \
    --model whisper-small \
    --epochs 20 \
    --patience 5 \
    --lr 5e-6 \
    --warmup_steps 500 \
    --dropout 0.15 \
    --label_smoothing 0.1 \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
