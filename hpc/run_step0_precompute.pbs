#!/bin/bash
# ============================================================
# PBS Job: Pre-compute IndicConformer Teacher Logits (Step 0)
# ============================================================
# Submit: qsub hpc/run_step0_precompute.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/step0_precompute.log
# ============================================================

#PBS -N step0_logits
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=15:00:00
#PBS -j oe

# Move to project directory
cd /iitjfs/home/2025rcs1026/Indain_children_spech

# Load conda
module load codes/anaconda3-2023.09
source activate children_asr

# GPU nodes have no internet — use cached models only
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/step0_precompute.log"

echo "============================================================" | tee $LOGFILE
echo "  STEP 0: PRE-COMPUTE TEACHER LOGITS (IndicConformer 600M)" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

# ── TRAIN SET ──
echo "" | tee -a $LOGFILE
echo ">>> Processing TRAIN set..." | tee -a $LOGFILE
python -u scripts/semantic/step0_precompute_teacher_logits.py \
    2>&1 | tee -a $LOGFILE

# ── DEV SET ──
echo "" | tee -a $LOGFILE
echo ">>> Processing DEV set..." | tee -a $LOGFILE
python -u scripts/semantic/step0_precompute_teacher_logits.py \
    --eval_set dev \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "  Train logits: $(ls teacher_logits/train/*.pt 2>/dev/null | wc -l) files" | tee -a $LOGFILE
echo "  Dev logits:   $(ls teacher_logits/dev/*.pt 2>/dev/null | wc -l) files" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
