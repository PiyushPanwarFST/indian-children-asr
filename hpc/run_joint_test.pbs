#!/bin/bash
# ============================================================
# PBS Job: Joint Training — TEST RUN (2000 clips, 5 epochs)
# ============================================================
# Submit: qsub hpc/run_joint_test.pbs
# Monitor: qstat -u 2025rcs1026
# Live logs: tail -f ~/Indain_children_spech/hpc/joint_test.log
# ============================================================

#PBS -N joint_test
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=12:00:00
#PBS -j oe

# Move to project directory
cd /iitjfs/home/2025rcs1026/Indain_children_spech

# Load conda
module load codes/anaconda3-2023.09
source activate children_asr

# GPU nodes have no internet — use cached models only
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1

# Force Python to flush output immediately
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/joint_test.log"

echo "============================================================" | tee $LOGFILE
echo "  JOINT TRAINING — TEST RUN (2000 clips, 5 epochs)" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo ">>> Joint training: encoder (UNFROZEN) + projection + CTC head" | tee -a $LOGFILE
echo ">>> Encoder warm start: checkpoints/acoustic/hpc_best_dev_model.pt" | tee -a $LOGFILE
echo ">>> CTC warm start: checkpoints/semantic/hpc_ctc_best_wer.pt" | tee -a $LOGFILE
echo ">>> Teacher: Kid-Whisper Medium (FROZEN)" | tee -a $LOGFILE
echo ">>> Loss: 0.5*MSE + 0.5*CTC" | tee -a $LOGFILE
echo ">>> Data: 2000 train clips (test run)" | tee -a $LOGFILE
echo "" | tee -a $LOGFILE

python -u scripts/joint/joint_training.py \
    --max_clips 2000 \
    --epochs 5 \
    --lr 3e-5 \
    --patience 5 \
    --warmup_steps 500 \
    --alpha 0.5 \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
