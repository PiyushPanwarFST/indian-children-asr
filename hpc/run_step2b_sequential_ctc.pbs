#!/bin/bash
# ============================================================
# PBS Job: Step 2b — Sequential CTC on Frozen Semantic Encoder
# ============================================================
# Submit: qsub hpc/run_step2b_sequential_ctc.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/step2b_sequential_ctc.log
# ============================================================

#PBS -N sem_seq_ctc
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=06:00:00
#PBS -j oe

# Move to project directory
cd /iitjfs/home/2025rcs1026/Indain_children_spech

# Load conda
module load codes/anaconda3-2023.09
source activate children_asr

# GPU nodes have no internet — use cached models only
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/step2b_sequential_ctc.log"

echo "============================================================" | tee $LOGFILE
echo "  STEP 2b: SEQUENTIAL CTC ON FROZEN SEMANTIC ENCODER" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u scripts/semantic/step2b_sequential_ctc.py \
    --epochs 30 \
    --patience 5 \
    --lr 1e-3 \
    --warmup_steps 200 \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
