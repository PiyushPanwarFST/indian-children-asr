#!/bin/bash
# ============================================================
# PBS Job: Exp 3 CONTINUATION — CTC-only, ALL layers UNFROZEN
# ============================================================
# Resumes from latest checkpoint (epoch 18+)
# Submit: qsub hpc/run_exp3_continue.pbs
# ============================================================

#PBS -N sem_unfroz_c
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=12:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/exp3_continue.log"

echo "============================================================" | tee $LOGFILE
echo "  EXP 3 CONTINUATION: CTC-only, ALL UNFROZEN" | tee -a $LOGFILE
echo "  Resuming from: checkpoints/semantic_ctc_unfrozen/best_dev.pt" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u experiments/semantic_branch/04_joint_training/step3_semantic_joint_training.py \
    --ctc_only \
    --freeze_layers 0 \
    --epochs 40 \
    --lr 2e-5 \
    --warmup_steps 500 \
    --patience 10 \
    --grad_accum 4 \
    --dropout 0.1 \
    --resume checkpoints/semantic_ctc_unfrozen/best_dev.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
