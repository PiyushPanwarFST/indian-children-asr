#!/bin/bash
# ============================================================
# PBS Job: Combined Branch — UNFROZEN Encoders FULL RUN
# ============================================================
# Submit: qsub hpc/run_combined_unfrozen_full.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/combined_unfrozen_full.log
# ============================================================
# Key difference from frozen run: both encoders are fine-tuned
# with a small LR (1e-5) while fusion+CTC use normal LR (1e-3).
# This lets encoders co-adapt for complementary features.
# ============================================================

#PBS -N comb_unfroz
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=36:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/combined_unfrozen_full.log"

echo "============================================================" | tee $LOGFILE
echo "  COMBINED BRANCH: UNFROZEN ENCODERS — FULL TRAINING" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u experiments/combined_branch/01_feature_fusion/step1_combined_training.py \
    --epochs 30 \
    --patience 10 \
    --lr 1e-3 \
    --encoder_lr 1e-5 \
    --warmup_steps 500 \
    --dropout 0.1 \
    --unfreeze_encoders \
    --grad_checkpoint \
    --acoustic_ckpt checkpoints/joint/joint_best_wer.pt \
    --semantic_ckpt checkpoints/semantic_mse/best_dev.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
