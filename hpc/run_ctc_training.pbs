#!/bin/bash
# ============================================================
# PBS Job: CTC Head Training (Sequential — on frozen encoder)
# ============================================================
# Submit: qsub hpc/run_ctc_training.pbs
# Monitor: qstat -u 2025rcs1026
# Live logs: tail -f ~/Indain_children_spech/hpc/ctc_live.log
# ============================================================

#PBS -N ctc_head_train
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=12:00:00
#PBS -j oe

# Move to project directory
cd /iitjfs/home/2025rcs1026/Indain_children_spech

# Load conda
module load codes/anaconda3-2023.09
source activate children_asr

# GPU nodes have no internet — use cached models only
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1

# Force Python to flush output immediately (no buffering)
export PYTHONUNBUFFERED=1

# Log file — write directly to shared filesystem so login node can read it live
LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/ctc_live.log"

echo "============================================================" | tee $LOGFILE
echo "  CTC HEAD TRAINING — Full Dataset" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo ">>> CTC training: frozen encoder + trainable CTC head" | tee -a $LOGFILE
echo ">>> Encoder: checkpoints/acoustic/hpc_best_dev_model.pt" | tee -a $LOGFILE
echo ">>> Vocab: ASER-Dataset/vocab.json (85 tokens)" | tee -a $LOGFILE
echo ">>> Data: 13,765 train clips, all languages" | tee -a $LOGFILE
echo "" | tee -a $LOGFILE

python -u scripts/semantic/ctc_training.py \
    --epochs 30 \
    --lr 1e-3 \
    --patience 5 \
    --warmup_steps 500 \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
