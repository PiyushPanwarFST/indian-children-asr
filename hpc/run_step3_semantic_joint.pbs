#!/bin/bash
# ============================================================
# PBS Job: Step 3 — Semantic Branch Joint Training (MSE + CTC)
# ============================================================
# Submit: qsub hpc/run_step3_semantic_joint.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/step3_semantic_joint.log
# ============================================================

#PBS -N sem_joint
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=24:00:00
#PBS -j oe

# Move to project directory
cd /iitjfs/home/2025rcs1026/Indain_children_spech

# Load conda
module load codes/anaconda3-2023.09
source activate children_asr

# GPU nodes have no internet — use cached models only
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/step3_semantic_joint.log"

echo "============================================================" | tee $LOGFILE
echo "  STEP 3: SEMANTIC BRANCH — JOINT TRAINING (MSE + CTC)" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u scripts/semantic/step3_semantic_joint_training.py \
    --epochs 30 \
    --patience 7 \
    --lr 2e-5 \
    --alpha_start 0.3 \
    --grad_accum 4 \
    --freeze_layers 6 \
    --dropout 0.1 \
    --warmup_steps 1000 \
    --checkpoint checkpoints/semantic_mse/best_dev.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
