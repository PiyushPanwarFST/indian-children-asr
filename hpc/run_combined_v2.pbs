#!/bin/bash
# ============================================================
# PBS Job: Combined Fusion V2 — Better Semantic Encoder
# ============================================================
# Uses best semantic encoder from Exp 3 (CTC-only unfrozen, 12.77%)
# instead of the original semantic_mse/best_dev.pt
# Submit: qsub hpc/run_combined_v2.pbs
# ============================================================

#PBS -N combined_v2
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=72:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/combined_v2.log"

echo "============================================================" | tee $LOGFILE
echo "  COMBINED V2: Gated Fusion with Better Semantic Encoder" | tee -a $LOGFILE
echo "  Acoustic: checkpoints/joint/joint_best_wer.pt" | tee -a $LOGFILE
echo "  Semantic: checkpoints/semantic_ctc_unfrozen/best_dev.pt" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u experiments/combined_branch/01_feature_fusion/step1_combined_training.py \
    --acoustic_ckpt checkpoints/joint/joint_best_wer.pt \
    --semantic_ckpt checkpoints/semantic_ctc_unfrozen/best_dev.pt \
    --epochs 45 \
    --lr 1e-3 \
    --encoder_lr 1e-5 \
    --warmup_steps 500 \
    --patience 12 \
    --dropout 0.1 \
    --grad_checkpoint \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
