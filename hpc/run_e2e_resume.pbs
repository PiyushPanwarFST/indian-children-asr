#!/bin/bash
# ============================================================
# PBS Job: E2E Resume from Epoch 25 — Fixed KD weights + LR warm restart
# ============================================================
# Fixes: keep KD as regularizer (0.5/0.3/0.15), fresh LR (1e-5/3e-4),
#        grad_accum 8 for stability. 20 more epochs from epoch 25.
# Submit: qsub hpc/run_e2e_resume.pbs
# ============================================================

#PBS -N e2e_resume
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=72:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/e2e_resume.log"

echo "============================================================" > $LOGFILE
echo "  E2E RESUME from Epoch 25 — Warm Restart + Fixed KD Weights" >> $LOGFILE
echo "  Weights: CTC=0.5 | Acou=0.3 | Sem=0.15 (FIXED)" >> $LOGFILE
echo "  LR: encoder=1e-5 | fusion=3e-4 (FRESH, warm restart)" >> $LOGFILE
echo "  Grad accum: 8 | Epochs: 20 more" >> $LOGFILE
echo "  Node: $(hostname)" >> $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'NO GPU')" >> $LOGFILE
echo "  Started: $(date)" >> $LOGFILE
echo "============================================================" >> $LOGFILE

python -u experiments/end_to_end/e2e_training.py \
    --resume checkpoints/e2e/epoch_25.pt \
    --fresh_optimizer \
    --fixed_weights \
    --epochs 20 \
    --patience 10 \
    --encoder_lr 1e-5 \
    --fusion_lr 3e-4 \
    --warmup_steps 200 \
    --grad_accum 8 \
    --grad_checkpoint \
    --specaugment \
    --dropout 0.1 \
    --w_ctc 0.5 \
    --w_acoustic 0.3 \
    --w_semantic 0.15 \
    --w_ortho 0.01 \
    >> $LOGFILE 2>&1

EXIT_CODE=$?
echo "" >> $LOGFILE
echo "  EXIT CODE: $EXIT_CODE" >> $LOGFILE
echo "  DONE: $(date)" >> $LOGFILE
