#!/bin/bash
# ============================================================
# PBS Job: Semantic Joint (MSE+CTC) — ALL layers UNFROZEN (test)
# ============================================================
# Submit: qsub hpc/run_semantic_joint_unfrozen_test.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/semantic_joint_unfrozen_test.log
# ============================================================
# Previous joint (freeze_layers=6): 50.24% WER (Head 2)
# CTC-only unfrozen (freeze_layers=0): 33.62% dev WER after epoch 2
# Hypothesis: joint MSE+CTC with all unfrozen → even better Hindi+Marathi
# Then decode with Head 2 (BPE) which always outperforms Head 1
# ============================================================
# Languages: Hindi + Marathi ONLY (needs teacher logits for MSE)
# Saves to: checkpoints/semantic_joint_unfrozen/
# ============================================================

#PBS -N sem_jnt_unfr_test
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=06:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/semantic_joint_unfrozen_test.log"

echo "============================================================" | tee $LOGFILE
echo "  SEMANTIC JOINT (MSE+CTC): ALL LAYERS UNFROZEN — TEST" | tee -a $LOGFILE
echo "  3000 clips (Hindi + Marathi only)" | tee -a $LOGFILE
echo "  Warm start: semantic_mse/best_dev.pt" | tee -a $LOGFILE
echo "  CTC Head 1 warm: semantic_ctc/best_wer.pt" | tee -a $LOGFILE
echo "  freeze_layers=0 (ALL 12 layers + conv trainable)" | tee -a $LOGFILE
echo "  Loss: alpha*MSE(Head2) + (1-alpha)*CTC(Head1)" | tee -a $LOGFILE
echo "  Dev WER tracked via Head 1 (char vocab)" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

# Phase 1: Joint training (MSE+CTC, all layers unfrozen)
python -u experiments/semantic_branch/04_joint_training/step3_semantic_joint_training.py \
    --freeze_layers 0 \
    --test_clips 3000 \
    --epochs 10 \
    --lr 2e-5 \
    --warmup_steps 500 \
    --patience 5 \
    --alpha_start 0.3 \
    --grad_accum 4 \
    --dropout 0.1 \
    --checkpoint checkpoints/semantic_mse/best_dev.pt \
    --ctc_checkpoint checkpoints/semantic_ctc/best_wer.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  JOINT TRAINING DONE. NOW EVALUATING WITH HEAD 2 (BPE)..." | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

# Phase 2: Decode best checkpoint with Head 2 (BPE vocab)
python -u experiments/semantic_branch/02_mse_distillation/step2_semantic_evaluate.py \
    --checkpoint checkpoints/semantic_joint_unfrozen/best_dev.pt \
    --split dev \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  ALL DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
