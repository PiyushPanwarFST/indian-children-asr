#!/bin/bash
# ============================================================
# PBS Job: Combined Branch — FULL TRAINING + TEST EVALUATION
# ============================================================
# Runs step1 (training) then step2 (test eval) sequentially.
# Submit: qsub hpc/run_combined_train_and_eval.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/combined_train_and_eval.log
# ============================================================

#PBS -N comb_full
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=40:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/combined_train_and_eval.log"

echo "============================================================" | tee $LOGFILE
echo "  COMBINED BRANCH: FULL TRAINING + TEST EVALUATION" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

# ── STEP 1: Training (30 epochs, all clips, unfrozen encoders) ──
echo "" | tee -a $LOGFILE
echo ">>> STARTING TRAINING <<<" | tee -a $LOGFILE
echo "" | tee -a $LOGFILE

python -u experiments/combined_branch/01_feature_fusion/step1_combined_training.py \
    --epochs 30 \
    --patience 10 \
    --lr 1e-3 \
    --encoder_lr 1e-5 \
    --warmup_steps 500 \
    --dropout 0.1 \
    --grad_checkpoint \
    --acoustic_ckpt checkpoints/joint/joint_best_wer.pt \
    --semantic_ckpt checkpoints/semantic_mse/best_dev.pt \
    2>&1 | tee -a $LOGFILE

TRAIN_EXIT=$?

echo "" | tee -a $LOGFILE
echo ">>> TRAINING FINISHED (exit code: $TRAIN_EXIT) <<<" | tee -a $LOGFILE
echo "" | tee -a $LOGFILE

# ── STEP 2: Test set evaluation (skip baseline to save memory) ──
if [ $TRAIN_EXIT -eq 0 ] && [ -f checkpoints/combined_unfrozen/best_wer.pt ]; then
    echo ">>> STARTING TEST EVALUATION <<<" | tee -a $LOGFILE
    echo "" | tee -a $LOGFILE

    python -u experiments/combined_branch/01_feature_fusion/step2_combined_evaluate.py \
        --per_lang 9999 \
        --eval_set test \
        --combined_ckpt checkpoints/combined_unfrozen/best_wer.pt \
        --acoustic_ckpt checkpoints/joint/joint_best_wer.pt \
        --skip_baseline \
        2>&1 | tee -a $LOGFILE

    echo "" | tee -a $LOGFILE
    echo ">>> EVALUATION FINISHED <<<" | tee -a $LOGFILE
else
    echo ">>> SKIPPING EVALUATION (training failed or no checkpoint) <<<" | tee -a $LOGFILE
fi

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  ALL DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
