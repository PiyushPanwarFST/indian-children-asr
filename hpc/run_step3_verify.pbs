#!/bin/bash
# ============================================================
# PBS Job: Step 3 VERIFY — Quick test (100 clips × 3 epochs)
# ============================================================
# Submit: qsub hpc/run_step3_verify.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/step3_verify.log
# ============================================================

#PBS -N sem_joint_verify
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=02:00:00
#PBS -j oe

# Move to project directory
cd /iitjfs/home/2025rcs1026/Indain_children_spech

# Load conda
module load codes/anaconda3-2023.09
source activate children_asr

# GPU nodes have no internet — use cached models only
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/step3_verify.log"

echo "============================================================" | tee $LOGFILE
echo "  STEP 3 VERIFY: QUICK TEST (100 clips × 3 epochs)" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u scripts/semantic/step3_semantic_joint_training.py \
    --verify \
    --test_clips 100 \
    --checkpoint checkpoints/semantic_mse/best_dev.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
