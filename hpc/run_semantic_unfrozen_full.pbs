#!/bin/bash
# ============================================================
# PBS Job: Semantic Branch — CTC-only, ALL layers UNFROZEN (full)
# ============================================================
# Submit: qsub hpc/run_semantic_unfrozen_full.pbs
# Monitor: tail -f ~/Indain_children_spech/hpc/semantic_unfrozen_full.log
# ============================================================
# Full training after test run confirms learning.
# All 12 encoder layers + conv layers unfrozen.
# Saves to: checkpoints/semantic_ctc_unfrozen/
# ============================================================

#PBS -N sem_unfrozen_full
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=24:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/semantic_unfrozen_full.log"

echo "============================================================" | tee $LOGFILE
echo "  SEMANTIC CTC-ONLY: ALL LAYERS UNFROZEN — FULL TRAINING" | tee -a $LOGFILE
echo "  Warm start: semantic_mse/best_dev.pt" | tee -a $LOGFILE
echo "  CTC Head 1 warm: semantic_ctc/best_wer.pt" | tee -a $LOGFILE
echo "  freeze_layers=0 (ALL 12 layers + conv trainable)" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "  GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u experiments/semantic_branch/04_joint_training/step3_semantic_joint_training.py \
    --ctc_only \
    --freeze_layers 0 \
    --epochs 30 \
    --lr 2e-5 \
    --warmup_steps 1000 \
    --patience 7 \
    --grad_accum 4 \
    --dropout 0.1 \
    --checkpoint checkpoints/semantic_mse/best_dev.pt \
    --ctc_checkpoint checkpoints/semantic_ctc/best_wer.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
