#!/bin/bash
# ============================================================
# PBS Job: Evaluate Semantic Sequential CTC on TEST set
# ============================================================
# Submit: qsub hpc/run_eval_semantic_seq_ctc.pbs
# Monitor: tail -f /iitjfs/home/2025rcs1026/Indain_children_spech/hpc/eval_semantic_seq_ctc.log
# ============================================================

#PBS -N eval_sem_seq_ctc
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40
#PBS -l walltime=02:00:00
#PBS -j oe

cd /iitjfs/home/2025rcs1026/Indain_children_spech

module load codes/anaconda3-2023.09
source activate children_asr

export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

LOGFILE="/iitjfs/home/2025rcs1026/Indain_children_spech/hpc/eval_semantic_seq_ctc.log"

echo "============================================================" | tee $LOGFILE
echo "  EVAL: Semantic Sequential CTC — TEST SET" | tee -a $LOGFILE
echo "  Started: $(date)" | tee -a $LOGFILE
echo "  Node: $(hostname)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE

python -u experiments/semantic_branch/03_sequential_ctc/step2c_sequential_ctc_evaluate.py \
    --split test \
    --encoder_ckpt checkpoints/semantic_mse/best_dev.pt \
    --ctc_ckpt checkpoints/semantic_ctc/best_wer.pt \
    2>&1 | tee -a $LOGFILE

echo "" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
echo "  DONE: $(date)" | tee -a $LOGFILE
echo "============================================================" | tee -a $LOGFILE
